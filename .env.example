# Required by Airflow's docker-compose for file permission handling
AIRFLOW_UID=50000

# LocalStack dummy credentials (safe to commit — not real AWS credentials)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=eu-central-1

# Step 3  — MS Teams webhook for pipeline notifications
 MS_TEAMS_WEBHOOK_URL=https://yourwebhook
